# ── Supabase (publieke anon key — mag in code staan) ──────────────────────────
# Deze worden hardcoded in services/supabaseClient.ts en hoeven hier niet te staan.

# ── Edge Function Secrets (NOOIT in deze file — stel in via Supabase dashboard) ─
# Ga naar: Supabase Dashboard → Edge Functions → Secrets
#
#   GEMINI_API_KEY        = jouw-gemini-api-key
#   SCRAPINGBEE_API_KEY   = jouw-scrapingbee-api-key
#   SERPER_API_KEY        = jouw-serper-api-key
#   RESEND_API_KEY        = jouw-resend-api-key
#   CALLMEBOT_API_KEY     = jouw-callmebot-api-key
#
# Deze keys bereiken de browser NOOIT — ze draaien alleen server-side in Deno.
